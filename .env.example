# Fontes públicas gratuitas de vagas de dados (Remotive e RemoteOK).
# Ativas por padrão; defina como false para desligar uma delas.
ENABLE_REMOTIVE=true
ENABLE_REMOTEOK=true

# Opcional: acompanhar também a carreira de uma empresa específica no Gupy.
# Mantenha essa configuração apenas no seu .env local (não commitado) ou em
# secrets do GitHub Actions — nunca no código público.
CAREER_URL=
GUPY_API_URL=
GUPY_CAREER_PAGE_ID=
GUPY_API_TOKEN=
# Opcional: nomes de marca a remover do início do campo de localidade
# extraído da página (separados por vírgula), ex: "Grupo Acme,Acme"
LOCATION_PREFIX_STRIP=

KEYWORDS=analista de dados,cientista de dados,engenheiro de dados,engenharia de dados,data analyst,data scientist,data engineer,analytics,business intelligence,bi,machine learning,inteligencia artificial,governanca de dados,arquitetura de dados,etl,mlops,data science

# Webhook do Discord (Configurações do Servidor > Integrações > Webhooks)
DISCORD_WEBHOOK_URL="SEU WEBHOOK DO DISCORD AQUI"

DATA_DIR=data
BOOTSTRAP_SILENT=true
